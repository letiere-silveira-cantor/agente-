# Copie para .env (local) e cadastre as mesmas variáveis na Vercel (Settings > Environment Variables).

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. "high" pensa mais, mas demora mais (cuidado com o limite de 300 s da Vercel).
CLAUDE_EFFORT=medium

# Instagram (API da Meta)
META_ACCESS_TOKEN=
IG_USER_ID=
META_GRAPH_VERSION=v27.0

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Quem recebe o relatório: só dígitos, com 55 e DDD. Vários separados por vírgula.
WHATSAPP_DESTINATARIOS=5548999999999
# "modelo" (padrão): avisa com o modelo aprovado e manda o relatório quando a pessoa responder.
# "direto": manda o relatório na hora (só chega se a pessoa falou com o número nas últimas 24 h).
WHATSAPP_MODO=modelo
WHATSAPP_TEMPLATE=relatorio_semanal
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Invente uma senha qualquer e use a mesma no cadastro do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (developers.facebook.com > seu app > Configurações > Básico).
META_APP_SECRET=

# Login do site (só a RBTech entra). Preencha só na Vercel, nunca no GitHub.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Texto aleatório longo que assina o login. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Vercel
# Senha que protege as gerações automáticas. A Vercel envia sozinha no agendamento.
CRON_SECRET=
# Criado sozinho quando você conecta um Blob store ao projeto. Sem ele, no computador, tudo fica em .dados/.
BLOB_READ_WRITE_TOKEN=

FUSO_HORARIO=America/Sao_Paulo
